ECPAY_HASH_KEY=
ECPAY_HASH_IV=
# ECPAY_STAGE：可不填。填 production = 正式網址 payment.ecpay.com.tw；未填或非 production = 測試網址 payment-stage（須與商店代號／金鑰所屬環境一致）
# ECPAY_STAGE=production
# ECPAY_CHOOSE_PAYMENT=ALL

# PUBLIC_BASE_URL：選填。不填時在 Cloud Run 上會用「https:// + 請求的 Host」組 ReturnURL。
# PUBLIC_BASE_URL=https://bastro-bot-217800246535.asia-east1.run.app

# 綠界 ClientBackURL／OrderResultURL 導回（預設 GitHub Pages 付款結果頁）
# PAYMENT_SUCCESS_URL=https://astro.branddecoderai.com/member/payment-success.html
# PAYMENT_FAILED_URL=https://astro.branddecoderai.com/member/payment-failed.html

# 會員中心 LIFF（成功頁「返回會員中心」按鈕用，非綠界 ClientBackURL）
