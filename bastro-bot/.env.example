# LINE Messaging API
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

GEMINI_API_KEY=

# 綠界金流（系統設定 → 介接資訊 →「金流、MPOS」列的 MerchantID / HashKey / HashIV）
ECPAY_MERCHANT_ID=
ECPAY_HASH_KEY=
ECPAY_HASH_IV=
# 空或 stage = 測試環境 payment-stage；設為 production 則走正式 payment.ecpay.com.tw
ECPAY_STAGE=
# 選填：預設 ALL；可改 Credit、ATM、CVS 等（見綠界文件 ChoosePayment）
# ECPAY_CHOOSE_PAYMENT=ALL

# Cloud Run 公開網址（無尾隨斜線），供綠界 ReturnURL 幕後 POST（必填）
PUBLIC_BASE_URL=https://bastro-bot-217800246535.asia-east1.run.app

# 付款完成後「返回商店」按鈕導向（HTTPS）
MEMBER_PROFILE_URL=https://branddecoderai.com/member/profile.html

# Telegram 營收通知（擇一組命名即可）
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# TG_BOT_TOKEN=
# TG_CHAT_ID=

ADMIN_EMAILS=

